{
  "node_type": "node_catalogue_node",
  "class_name": "NodeCatalogueNode",
  "category": "data",
  "primary_family": "Utility",
  "display_name": "Node catalogue",
  "default_alias": "Node catalogue",
  "description": "Give an AI step bounded contracts for available nodes",
  "tags": [
    "meta",
    "workflow"
  ],
  "icon_name": "list-check",
  "selector_section": "Transform",
  "group": null,
  "execution_template": "producer",
  "payload_field": false,
  "ui_hints": {
    "standard_output": true
  },
  "outputs": {
    "default": {
      "name": "Catalogue",
      "type": "string",
      "required": true,
      "to": [
        "downstream",
        "vault"
      ],
      "description": "Complete matching contracts; errors if over the size cap"
    }
  },
  "output_routing": {
    "default": "transient",
    "vault": {
      "mode": "optional"
    }
  },
  "config_tabs": {
    "Parameters": {
      "scope": {
        "type": "select",
        "label": "Nodes",
        "options": [
          "All nodes",
          "Filtered",
          "Exact IDs",
          "Selected analysis"
        ],
        "tab": "Parameters",
        "default": "All nodes"
      },
      "group_filter": {
        "type": "select",
        "label": "Group",
        "options": [
          "Any group",
          "AI Processing",
          "Branch",
          "Data Transform",
          "File Reader",
          "File Write",
          "Hermes",
          "Merge",
          "Saved values",
          "System",
          "Text Input",
          "Text Output",
          "Text files",
          "Wait / Timer",
          "Web Request"
        ],
        "tab": "Parameters",
        "visible_when": {
          "scope": "Filtered"
        },
        "default": "Any group"
      },
      "tag_filter": {
        "type": "string",
        "label": "Tag",
        "tab": "Parameters",
        "visible_when": {
          "scope": "Filtered"
        },
        "placeholder": "Any tag",
        "default": ""
      },
      "search": {
        "type": "string",
        "label": "Search",
        "tab": "Parameters",
        "visible_when": {
          "scope": "Filtered"
        },
        "placeholder": "Type, name, description or tags",
        "default": ""
      },
      "detail": {
        "type": "select",
        "label": "Detail",
        "options": [
          "Brief",
          "Compact",
          "Detailed"
        ],
        "tab": "Parameters",
        "wrap_description": true,
        "description": "Brief: purpose, when to use, not for, effects and needs to shortlist nodes. Then Compact or Detailed, filtered to the chosen nodes, adds full records, ports and config.",
        "default": "Compact"
      },
      "format": {
        "type": "select",
        "label": "Output",
        "options": [
          "Text",
          "JSON"
        ],
        "tab": "Parameters",
        "description": "Text [string] or a JSON record [var].",
        "default": "Text"
      },
      "max_chars": {
        "type": "integer",
        "label": "Max catalogue (characters)",
        "min": 512,
        "max": 200000,
        "tab": "Parameters",
        "wrap_description": true,
        "description": "Complete output only; narrow filters if the cap is exceeded. Context Pack and model context have separate limits.",
        "default": 64000
      },
      "include_debug": {
        "type": "boolean",
        "label": "Include debug nodes",
        "default": false,
        "tab": "Parameters"
      },
      "type_ids_source": {
        "type": "select",
        "label": "Selection source",
        "options": [
          "Upstream payload",
          "Vault",
          "Configured"
        ],
        "default": "Configured"
      },
      "type_ids_vault_key": {
        "type": "string",
        "label": "Selection Vault key",
        "vault_type": "var",
        "visible_when": {
          "type_ids_source": "Vault"
        },
        "default": ""
      },
      "type_ids": {
        "type": "multiselect",
        "label": "Exact type IDs",
        "options": [
          "branch_end_node",
          "branch_node",
          "concat_node",
          "conditional_node",
          "end_node",
          "file_output_node",
          "file_reader_node",
          "json_path_node",
          "start_node",
          "text_output_node",
          "text_transform_node",
          "user_text_input_node"
        ],
        "visible_when": {
          "type_ids_source": "Configured"
        },
        "default": []
      },
      "selection_request_vault_key": {
        "type": "string",
        "label": "Original request Vault key",
        "default": ""
      },
      "discovery_request_vault_key": {
        "type": "string",
        "label": "Discovery request Vault key",
        "default": ""
      },
      "discovery_snapshot_vault_key": {
        "type": "string",
        "label": "Frozen discovery Vault key",
        "default": ""
      },
      "selection_clarification_vault_key": {
        "type": "string",
        "label": "Clarification Vault key",
        "default": ""
      }
    }
  },
  "errors": [
    {
      "code": "invalid_config",
      "description": "Check catalogue filters and limits.",
      "retryable": false
    },
    {
      "code": "catalogue_empty",
      "description": "No nodes match. Broaden the filters.",
      "retryable": false
    },
    {
      "code": "catalogue_too_large",
      "description": "Catalogue is too large. Narrow the filters or raise the cap.",
      "retryable": false
    },
    {
      "code": "selection_invalid",
      "description": "Unknown, duplicate, hidden or unadmitted selection; check the exact IDs.",
      "retryable": false
    },
    {
      "code": "selection_incomplete",
      "description": "A required role lacks an admitted, proven composition; no draft.",
      "retryable": false
    }
  ],
  "input_ports": [
    "input"
  ],
  "input_port_metadata": {
    "input": {
      "name": "Continue",
      "description": "All/Filtered: trigger only. Exact IDs: a list of identities; Selected analysis: requirements JSON.",
      "data_type": "any",
      "required": false,
      "sources": [
        "upstream"
      ]
    }
  }
}
