/* AttackOfTheNodes Textual styling.

   Colors are driven by the active Textual theme (design-system tokens such as
   $background, $surface, $panel, $boost, $primary, $accent, $foreground,
   $text-muted) rather than hardcoded hex values. One accent ($primary) is used
   consistently for focus, active tabs, and selection. */

Screen {
    background: $background;
    color: $foreground;
}

#editor-root {
    height: 100%;
}

#workflow-title {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $foreground;
}

#editor-columns {
    height: 1fr;
}

.panel {
    border: round $foreground 15%;
    height: 100%;
    padding: 0 1;
}

#nodes-panel {
    width: 45%;
}

#details-panel {
    width: 55%;
}

.panel-title {
    height: 1;
    color: $accent;
    text-style: bold;
}

/* The node list paints to the bottom of the panel viewport. */
#node-list {
    height: 1fr;
    background: $background;
}

#node-list ListItem.-highlight {
    background: transparent;
}

.node-card {
    height: 1;
}

.node-card-identity {
    height: 4;
}

.gap-arrow-card {
    height: 1;
}

.branch-select-card {
    height: 1;
}

.merge-beacon-select-card {
    height: 1;
}

#node-details {
    height: 1fr;
    overflow-y: auto;
}

#recent-output {
    height: 1fr;
}

/* Modals sit at the top left. Small ones are sized to their content and may
   grow to the whole terminal; the large ones below fill it (owner,
   2026-10-20: no unused strip on the right and at the bottom). */
#modal-card {
    width: auto;
    min-width: 50;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    /* A dialog taller than the terminal scrolls; W/S scroll to its buttons. */
    overflow-y: auto;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

/* The node config modal carries dense tabbed forms: keep it large. */
#modal-card.node-config-modal {
    width: 100%;
    height: 100%;
}

/* The node selector needs room for its list and detail line. */
#modal-card.node-selector-modal {
    width: 100%;
    height: 100%;
}

/* Data-heavy modals (e.g. the memory viewer) fill the available height. */
#modal-card.fill-modal {
    width: 100%;
    height: 100%;
}

#node-config-scroll {
    height: 1fr;
    overflow-y: auto;
}

/* Tabbed config screens: TabbedContent is pinned, scroll lives inside each pane. */
#node-config-tabs {
    height: 1fr;
}

/* File window and Options: the tabs take the height left above the buttons
   and key hints, and the lists scroll inside them (#93 review). */
#modal-card.library-modal,
#modal-card.settings-modal {
    width: 100%;
    height: 100%;
}

#library-tabs,
#settings-tabs {
    height: 1fr;
}

#library-tabs ListView {
    height: 1fr;
}

.tab-scroll {
    height: 1fr;
    overflow-y: auto;
}

.saved-key-list {
    height: 6;
    min-height: 3;
    border: round $foreground 15%;
    background: $background;
}

/* Node selector layout: keep the tab row and filter compact (containers
   default to height 1fr and would otherwise stretch and leave dead space),
   and let the node list absorb the remaining height. */
#node-family-tabs {
    height: auto;
}

/* Family tabs: flat, content-sized buttons with minimal padding so all five
   fit across a half-screen modal, then simply gain breathing room (more empty
   space to the right) when the terminal — and the modal — scale up. */
#node-family-tabs Button {
    min-width: 0;
    width: auto;
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
}

#node-filter {
    height: auto;
}

/* Master-detail horizontal split inside the selector body. */
#node-selector-body {
    height: 1fr;
}

#node-type-list {
    width: 40%;
    height: 1fr;
    min-height: 4;
    min-width: 18;
}

#node-detail-panel {
    width: 60%;
    height: 1fr;
    border-left: solid $foreground 15%;
    padding: 0 1;
}

/* One-line scan rows: descriptions live in the detail line, not on the row. */
#node-type-list ListItem {
    height: auto;
}

.node-select-row {
    height: 1;
}

.node-select-group {
    height: 1;
}

/* Section headers inside the selector list: non-selectable, muted dividers
   that keyboard navigation skips. */
.node-select-header {
    height: 1;
    color: $text-muted;
}

/* Contract detail panel content — expands to fill the panel scroll area. */
.node-detail {
    width: 1fr;
    color: $text-muted;
}

/* Two-line member rows inside the Group Picker. */
.group-member-row {
    height: 2;
}

#group-member-list {
    height: 1fr;
    min-height: 4;
}

#membank-output-rows {
    height: auto;
}

#branch-payload-rows {
    height: auto;
}

.branch-payload-row {
    height: auto;
    align: left middle;
}

.branch-payload-headings {
    height: auto;
    margin-top: 1;
}

.branch-heading-id {
    width: 1fr;
}

.branch-heading-source {
    width: 2fr;
}

.branch-payload-row > CommandInput {
    width: 1fr;
    margin-top: 1;
}

.branch-payload-row > Select {
    width: 2fr;
}

.generated-form {
    height: auto;
}

.generated-form-page {
    height: auto;
}

.membank-output-field {
    width: 100%;
}

/* Calm selection: a subtle boost background, an accent left indicator, and
   bold text rather than a loud full-row fill. */
.nav-highlight {
    background: $boost;
    color: $foreground;
    text-style: bold;
}

.row--selected {
    background: $boost;
    border-left: thick $primary;
    text-style: bold;
}

.modal-title {
    height: 1;
    color: $accent;
    text-style: bold;
}

.modal-help {
    color: $text-muted;
}

.form-label {
    margin-top: 1;
    color: $foreground;
    text-style: bold;
}

.nav-section {
    color: $accent;
}

/* Inline label + widget row: label left, widget fills remaining width.
   Height is auto so bordered widgets (Select dropdowns) are not clipped. */
.form-inline-row {
    height: auto;
    margin-top: 1;
    align-vertical: middle;
}

.form-inline-row Select {
    width: 1fr;
}

.form-inline-row .command-input {
    width: 1fr;
}

.form-label-inline {
    height: auto;
    width: auto;
    max-width: 45%;
    color: $foreground;
    text-style: bold;
    padding: 0 1 0 0;
}

/* Header line above dropdowns/tall widgets: bold label plus the muted
   description inline after it. */
.form-header-row {
    height: auto;
    margin-top: 1;
}

.form-description-inline {
    height: 1;
    width: auto;
    padding: 0 0 0 1;
}

/* Section headers inside generated forms (schema `section` key). */
.form-section-label {
    margin-top: 1;
}

.payload-header {
    color: $foreground;
    margin-top: 1;
}

.form-description {
    color: $text-muted;
}

/* C5: a number field's problem, shown under the field until fixed. */
.field-error {
    color: $error;
    height: auto;
}

.payload-preview:focus {
    background: $boost;
    color: $foreground;
    text-style: bold;
}

/* Generated single-line inputs are compact (one row) with a reserved left
   accent column that lights up on focus/edit. Multiline/code fields use
   CommandTextArea and stay tall. */
.command-input {
    width: 100%;
}

.command-input.single-line {
    height: 1;
    border-top: none;
    border-bottom: none;
    border-right: none;
    border-left: thick $surface;
    padding: 0 2;
}

.command-input.single-line:focus {
    border-top: none;
    border-bottom: none;
    border-right: none;
    border-left: thick $primary;
    background: $boost;
}

.command-input.single-line.editing:focus {
    border-top: none;
    border-bottom: none;
    border-right: none;
    border-left: thick $accent;
    background: $boost;
}

/* Multiline command text areas keep the tall focus border. */
.command-input:focus {
    border-left: thick $primary;
}

.command-input.editing:focus {
    border-left: thick $accent;
}

.pass-through-note {
    color: $success;
}

.button-row {
    height: auto;
    margin-top: 1;
}

StatusBar {
    background: $panel;
    color: $text-muted;
}

/* Checkboxes: both states use the same quiet light-grey fill. Textual's
   inner X is always rendered, so the unchecked glyph matches the fill color. */
Checkbox > .toggle--button {
    background: $foreground 20%;
    color: $foreground 20%;
}

Checkbox:focus > .toggle--button {
    background: $foreground 30%;
    color: $foreground 30%;
}

Checkbox.-on > .toggle--button {
    color: $foreground;
    text-style: bold;
}

Checkbox.-on:focus > .toggle--button {
    background: $foreground 30%;
    color: $foreground;
}

/* Group drill-in quick list: compact auto-height list inside the detail panel. */
.node-quick-list {
    height: auto;
    background: $background;
    margin-bottom: 1;
}

.node-quick-list ListItem {
    height: 1;
}

/* One lighter active-tab style shared by the node selector and node config so
   tabs look the same in both. */
Tab {
    color: $text-muted;
}

Tab.-active {
    color: $accent;
    text-style: bold;
}

/* UX4: Errors section button (spawn or open an Error Resolver / Error Mux):
   one compact row, no heavy border (owner). */
.catch-errors-button {
    margin: 1 0;
}

/* UX5: Connections tab rows. Plain text lines; Enter on a row jumps to the
   node at the other end. The focused row is highlighted. */
#connection-rows {
    height: auto;
}

.connection-heading {
    margin-top: 1;
}

.connection-row {
    width: 1fr;
    text-align: left;
    content-align: left middle;
    background: transparent;
    color: $text;
}

.connection-row:focus {
    background: $accent 30%;
    text-style: bold;
}

/* UX6: an open dropdown list must not look like the closed dropdown boxes
   around it (owner, Branch rows). A rounded accent border, a darker panel and
   a bold highlighted option set it apart; it applies to every dropdown. */
SelectOverlay {
    border: round $accent;
    background: $panel-darken-2;
}

SelectOverlay > .option-list--option-highlighted {
    background: $accent 40%;
    text-style: bold;
}

/* Stash (S2): the tabs take the height left above the Close row and the
   docked help line; lists fill their tab; rows stay on one line. */
.stash-modal #stash-tabs {
    height: 1fr;
}

.stash-modal #stash-tabs ContentSwitcher,
.stash-modal #stash-tabs TabPane {
    height: 1fr;
}

.stash-modal > .button-row {
    margin-bottom: 1;
}

.stash-list {
    height: 1fr;
}

.stash-row {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.stash-paste {
    height: 4;
}

/* Help: the text scrolls inside a bounded card so Close stays reachable. */
#modal-card.help-modal {
    height: 100%;
}

#help-scroll {
    height: 1fr;
}

/* Execution screen (EX): the run map on the left, the highlighted node on the
   right; under 80 columns the details go below the map. */
#execution-title {
    height: 1;
    padding: 0 1;
}

#execution-columns {
    height: 1fr;
}

#execution-panel {
    width: 52;
}

#execution-side {
    width: 1fr;
}

#execution-details {
    height: 1fr;
    overflow-y: auto;
}

#execution-output {
    height: 4;
    color: $text-muted;
}

#execution-error {
    height: auto;
    border: round $error;
    padding: 0 1;
}

#execution-error .button-row {
    height: auto;
}

ExecutionScreen.narrow #execution-columns {
    layout: vertical;
}

ExecutionScreen.narrow #execution-panel {
    width: 1fr;
    height: 1fr;
}

/* The error panel comes first and the pane scrolls, so its buttons stay
   reachable on a short terminal. */
ExecutionScreen.narrow #execution-side {
    height: 1fr;
    overflow-y: auto;
}

ExecutionScreen.narrow #execution-details {
    height: auto;
}
