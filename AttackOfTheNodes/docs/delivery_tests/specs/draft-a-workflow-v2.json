        "detail": "Compact",
        "format": "Text",
        "include_debug": false,
        "max_chars": 16000,
        "group_filter": "Branch",
        "search": "parallel simultaneous",
        "transient_output": true,
        "vault_write": true,
        "vault_write_key": "contracts_parallel"
      }
    },
    "catalogue_conditional": {
      "type": "node_catalogue_node",
      "alias": "Read conditional contract",
      "config": {
        "scope": "Filtered",
        "detail": "Compact",
        "format": "Text",
        "include_debug": false,
        "max_chars": 16000,
        "search": "conditional_node",
        "transient_output": true,
        "vault_write": true,
        "vault_write_key": "contracts_conditional"
      }
    },
    "catalogue_concat": {
      "type": "node_catalogue_node",
      "alias": "Read concat contract",
      "config": {
        "scope": "Filtered",
        "detail": "Compact",
        "format": "Text",
        "include_debug": false,
        "max_chars": 16000,
        "search": "concat_node",
        "transient_output": true,
        "vault_write": true,
        "vault_write_key": "contracts_concat"
      }
    },
    "catalogue_json_path": {
